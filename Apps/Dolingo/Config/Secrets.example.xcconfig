// Copy to Secrets.xcconfig and fill in. Secrets.xcconfig is git-ignored.
// On CI it is recreated from GitHub Secrets.
FIREBASE_API_KEY =
ADMOB_APP_ID =
// The Dolingo AI server (Backend/dolingo-ai, docs/AI-Deploy.md) and its CLIENT_KEY: AI_BASE_URL
// for Dev builds, then one per configuration. Empty: the tutor chat answers with a local
// placeholder. Write URLs as https:/$()/host so // isn't read as a comment.
AI_BASE_URL =
AI_BASE_URL_STAGING =
AI_BASE_URL_PROD =
AI_CLIENT_KEY =
// REVERSED_CLIENT_ID from Resources/Firebase/GoogleService-Info-<Env>.plist, for Google Sign-In.
GOOGLE_REVERSED_CLIENT_ID =
