        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vì sao Dolingo cần micro?"
          }
        }
      }
    },
    "faq.offline.a": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Yes. Lessons, roleplays and the phrasebook are inside the app, and progress is saved on your phone."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Được. Bài học, roleplay và sổ tay câu có sẵn trong app; tiến độ được lưu trên máy."
          }
        }
      }
    },
    "faq.offline.q": {
      "extractionState": "manual",
      "localizations": {
