    "faq.cancel.a": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Go to Billing & Subscriptions > Manage Subscription, or iPhone Settings > Apple ID > Subscriptions. Cancel at least 24 hours before the period ends."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vào Gói & Thanh toán > Quản lý gói, hoặc Cài đặt iPhone > Apple ID > Đăng ký. Huỷ trước 24 giờ khi hết kỳ để không bị gia hạn."
          }
        }
      }
    },
    "faq.cancel.q": {
      "extractionState": "manual",
      "localizations": {
