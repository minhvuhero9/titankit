    "onboarding.welcome.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Learn languages whenever and wherever you want. It's all in your hands!"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Học ngoại ngữ mọi lúc, mọi nơi. Tất cả nằm trong tay bạn!"
          }
        }
      }
    },
