          }
        }
      }
    },
    "faq.data.a": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Speech is recognised on the device when it can be. Your progress stays on your phone."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giọng nói được nhận dạng ngay trên máy khi máy hỗ trợ. Tiến độ học lưu trên điện thoại của bạn."
          }
        }
      }
    },
