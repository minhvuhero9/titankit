    "faq.microphone.a": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To hear you speak and score your pronunciation. Without it you can still listen and read."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Để nghe bạn nói và chấm phát âm. Không bật micro bạn vẫn nghe và đọc được bài."
          }
        }
      }
    },
    "faq.microphone.q": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Why does Dolingo need the microphone?"
