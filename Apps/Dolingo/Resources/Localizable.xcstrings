    "faq.password.a": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap \"Forgot Password?\" on the sign-in screen, or go to Account & Security > Change Password. Dolingo emails you a one-time code to set a new password."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bấm \"Quên mật khẩu?\" ở màn đăng nhập, hoặc vào Tài khoản & Bảo mật > Đổi mật khẩu. Dolingo sẽ gửi email một mã dùng một lần để bạn đặt mật khẩu mới."
          }
        }
      }
    },
