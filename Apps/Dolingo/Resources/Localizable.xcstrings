    "faq.score.a": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dolingo compares each word you say with the phrase: 90% or more is Perfect, 60% or more is Almost there."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dolingo so từng từ bạn nói với câu mẫu: từ 90% là Hoàn hảo, từ 60% là Gần đúng."
          }
        }
      }
    },
