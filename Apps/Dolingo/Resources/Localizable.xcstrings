    "faq.free.a": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every lesson and some roleplays and speaking topics are free. Premium unlocks the rest."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Toàn bộ bài học và một phần roleplay, chủ đề luyện nói là miễn phí. Gói Premium mở khoá phần còn lại."
          }
        }
      }
    },
