    "tutor.greeting": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hello! I'm Dolingo, your English tutor. Ask me anything about English, or let's just chat in English!"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xin chào! Mình là Dolingo, gia sư tiếng Anh của bạn. Hãy hỏi mình bất cứ điều gì về tiếng Anh, hoặc cùng trò chuyện bằng tiếng Anh nhé!"
          }
        }
      }
    },
