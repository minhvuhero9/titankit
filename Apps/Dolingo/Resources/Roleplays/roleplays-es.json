                "en": "Nice to meet you. I'm Alex."
              },
              "completes": [
                "intro"
              ]
            }
          ]
        },
        {
          "partner": {
            "text": "¡Encantado de conocerte, Alex! ¿De dónde eres?",
            "meaning": {
