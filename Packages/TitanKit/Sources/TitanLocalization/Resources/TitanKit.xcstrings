      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hủy"
          }
        }
      }
    },
    "kit.common.ok": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OK"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đồng ý"
          }
        }
      }
    },
    "kit.common.retry": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try again"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thử lại"
          }
        }
      }
    },
    "kit.error.cancelled": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancelled."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã hủy."
          }
        }
      }
    },
    "kit.error.decoding": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We received data we couldn't read."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dữ liệu nhận được không hợp lệ."
          }
        }
      }
    },
    "kit.error.notFound": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We couldn't find that."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không tìm thấy nội dung."
          }
        }
      }
    },
    "kit.error.offline": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No internet connection. Check your Wi-Fi or mobile data."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không có kết nối mạng. Hãy kiểm tra Wi-Fi hoặc 4G."
          }
        }
      }
    },
    "kit.error.offline.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You're offline"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mất kết nối"
          }
        }
      }
    },
    "kit.error.server": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server is having trouble. Please try again later."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Máy chủ đang gặp sự cố. Hãy thử lại sau."
          }
        }
      }
    },
    "kit.error.storage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't save data on this device."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không lưu được dữ liệu trên máy."
          }
        }
      }
    },
    "kit.error.timeout": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server took too long to respond. Please try again."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Máy chủ phản hồi quá lâu. Hãy thử lại."
          }
        }
      }
    },
    "kit.error.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Something went wrong"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Có lỗi xảy ra"
          }
        }
      }
    },
    "kit.error.unauthorized": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your session has expired. Please sign in again."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phiên đăng nhập đã hết hạn. Hãy đăng nhập lại."
          }
        }
      }
    },
    "kit.error.unknown": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Something went wrong. Please try again."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã có lỗi xảy ra. Hãy thử lại."
          }
        }
      }
    },
    "kit.field.password.hide": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hide password"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ẩn mật khẩu"
          }
        }
      }
    },
    "kit.field.password.show": {
      "extractionState": "manual",
      "localizations": {
