{
  "name": "dolingo-ai",
  "private": true,
  "type": "module",
  "description": "Dolingo's AI server: keeps the Anthropic API key off the phone and streams Claude's replies to the app.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy:staging": "wrangler deploy --env staging",
    "deploy:prod": "wrangler deploy --env prod",
    "smoke": "node --experimental-strip-types --no-warnings scripts/smoke.ts",
    "check": "tsc --noEmit",
    "test": "node --test --experimental-strip-types --no-warnings test/*.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20260702.1",
    "@types/node": "22.19.0",
    "typescript": "5.9.3",
    "wrangler": "4.49.1"
  }
}
